# ===== DATABASE =====
DB_ROOT_PASSWORD=generate-dengan-node-crypto
DB_PASSWORD=generate-dengan-node-crypto
DB_USER=yasmin
DB_NAME=yasmin

# ===== AUTH =====
JWT_SECRET=generate-dengan-node-crypto
DEVICE_BOOTSTRAP_SECRET=generate-dengan-node-crypto

# ===== URL =====
PUBLIC_BASE_URL=http://localhost
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,https://localhost,https://localhost:5173

# ===== SERVER =====
NODE_ENV=development
PORT=8000

# ===== BUSINESS PROFILE API (OPSI A) =====
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...

# ===== PLACES API (OPSI B) =====
GOOGLE_MAPS_API_KEY=
RS_YASMIN_PLACE_ID=

# ===== STRATEGI SINKRONISASI =====
# Pilihan: 'gbp' (utamakan Opsi A), 'places' (utamakan Opsi B), atau 'auto' (coba A, lalu B jika gagal)
GOOGLE_SYNC_PREFERENCE=auto

# ===== INTEGRASI SIMRS =====
# Isi dengan URL API Trust Medis, mis: https://api.trustmedis.com/v1
# Biarkan kosong selama SIMRS belum tersambung.
SIMRS_BASE_URL=
# Isi dengan API key dari Trust Medis. Biarkan kosong jika belum ada.
SIMRS_API_KEY=

# ===== FRONTEND =====
VITE_BACKEND_URL=
VITE_GOOGLE_MAPS_API_KEY=

# Kunci ini HANYA untuk mengenkripsi setting di database. 
# JANGAN pernah diubah setelah ada data terenkripsi, atau semua key lama tidak bisa dibuka.
SETTINGS_ENCRYPTION_KEY=